 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Umlaut OS switch: Mac (default) / Windows / Linux
 *   Mac     : Option+U dead key (input source "U.S." or "ABC")
 *   Windows : Alt + numpad code (NumLock on)
 *   Linux   : Ctrl+Shift+U + hex + Enter (IBus / GTK)
 *
 * Switch modes: hold both layer thumbs (Control layer), then
 *   pos 33 = Mac, pos 34 = Windows, pos 35 = Linux.
 * Mode resets to Mac after reboot / deep sleep.
 *
 * Requires zmk-helpers as a west module (see config/west.yml).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"   // must come AFTER behaviors.dtsi

/* ------------------------------------------------------------------ */
/* Layers (order of ZMK_LAYER calls below must match these numbers)   */
/* ------------------------------------------------------------------ */
#define MAC      0   /* Base, Mac bindings */
#define WIN      1   /* Base overlay, Windows (also the Windows mode flag) */
#define LNX      2   /* Base overlay, Linux (also the Linux mode flag) */
#define NUM      3
#define WIN_NUM  4
#define LNX_NUM  5
#define SYM      6
#define WIN_SYM  7
#define LNX_SYM  8
#define CTRL     9
#define WIN_CTRL 10
#define LNX_CTRL 11

#define ___ &trans

/* zmk-helpers defaults to 30 ms combos; keep ZMK's 50 ms default */
#undef COMBO_TERM
#define COMBO_TERM 50

/* ------------------------------------------------------------------ */
/* Umlaut macros                                                      */
/* ------------------------------------------------------------------ */

/* Mac: Option+U dead key, then the (shifted) vowel */
#define MAC_DK(name, key) \
    ZMK_MACRO(name, wait-ms = <10>; tap-ms = <10>; bindings = <&kp LA(U) &kp key>;)

MAC_DK(mac_ae_lo, A)
MAC_DK(mac_ae_up, LS(A))
MAC_DK(mac_oe_lo, O)
MAC_DK(mac_oe_up, LS(O))
MAC_DK(mac_ue_lo, U)
MAC_DK(mac_ue_up, LS(U))

/* Windows: hold Alt, type 4 numpad digits */
#define WIN_ALT(name, d0, d1, d2, d3)                                                 \
    ZMK_MACRO(name, wait-ms = <0>; tap-ms = <0>;                                      \
        bindings = <&macro_press &kp LALT>,                                           \
                   <&macro_tap &kp KP_N##d0 &kp KP_N##d1 &kp KP_N##d2 &kp KP_N##d3>,  \
                   <&macro_release &kp LALT>;)

WIN_ALT(win_ae_lo,  0, 2, 2, 8)
WIN_ALT(win_ae_up,  0, 1, 9, 6)
WIN_ALT(win_oe_lo,  0, 2, 4, 6)
WIN_ALT(win_oe_up,  0, 2, 1, 4)
WIN_ALT(win_ue_lo,  0, 2, 5, 2)
WIN_ALT(win_ue_up,  0, 2, 2, 0)
WIN_ALT(win_eszett, 0, 2, 2, 3)
WIN_ALT(win_euro,   0, 1, 2, 8)

/* Linux: Ctrl+Shift+U, 4 hex digits, Enter.
 * LC(LS(U)) uses implicit mods, so the mod-morph's Shift mask can't eat it. */
#define LNX_UNI(name, h0, h1, h2, h3)                                     \
    ZMK_MACRO(name, wait-ms = <5>; tap-ms = <5>;                          \
        bindings = <&kp LC(LS(U)) &kp h0 &kp h1 &kp h2 &kp h3 &kp ENTER>;)

LNX_UNI(lnx_ae_lo,  N0, N0, E,  N4)
LNX_UNI(lnx_ae_up,  N0, N0, C,  N4)
LNX_UNI(lnx_oe_lo,  N0, N0, F,  N6)
LNX_UNI(lnx_oe_up,  N0, N0, D,  N6)
LNX_UNI(lnx_ue_lo,  N0, N0, F,  C)
LNX_UNI(lnx_ue_up,  N0, N0, D,  C)
LNX_UNI(lnx_eszett, N0, N0, D,  F)
LNX_UNI(lnx_euro,   N2, N0, A,  C)

/* Shift-aware umlaut keys: tap = lowercase, Shift+tap = uppercase */
#define UMLAUT(name, lo, up) \
    ZMK_MOD_MORPH(name, bindings = <&lo>, <&up>; mods = <(MOD_LSFT|MOD_RSFT)>;)

UMLAUT(ae_mac, mac_ae_lo, mac_ae_up)
UMLAUT(oe_mac, mac_oe_lo, mac_oe_up)
UMLAUT(ue_mac, mac_ue_lo, mac_ue_up)
UMLAUT(ae_win, win_ae_lo, win_ae_up)
UMLAUT(oe_win, win_oe_lo, win_oe_up)
UMLAUT(ue_win, win_ue_lo, win_ue_up)
UMLAUT(ae_lnx, lnx_ae_lo, lnx_ae_up)
UMLAUT(oe_lnx, lnx_oe_lo, lnx_oe_up)
UMLAUT(ue_lnx, lnx_ue_lo, lnx_ue_up)

/* Other OS-specific macros */
ZMK_MACRO(win_sleep, wait-ms = <200>; bindings = <&kp LG(X) &kp R &kp E>;)

/* Readable names for the Mac shortcuts used below */
#define MAC_LINE_START  &kp LG(LEFT)
#define MAC_LINE_END    &kp LG(RIGHT)
#define MAC_WORD_LEFT   &kp LA(LEFT)
#define MAC_WORD_RIGHT  &kp LA(RIGHT)
#define MAC_LOCK        &kp LC(LG(Q))
#define MAC_ESZETT      &kp LA(S)
#define MAC_EURO        &kp LA(LS(N2))
#define SCREENSHOT      &kp LC(LA(LG(N4)))   /* Ctrl+Opt+Cmd+4 */

/* ------------------------------------------------------------------ */
/* Combos                                                             */
/* ZMK_COMBO(name, binding, key positions, layers)                    */
/* Combo layers are checked against the HIGHEST active layer, so each */
/* OS mode gets its own umlaut combos.                                */
/* ------------------------------------------------------------------ */
ZMK_COMBO(esc,          &kp ESC,        2 1)
ZMK_COMBO(tab,          &kp TAB,        2 3)
ZMK_COMBO(c_capsword,   &caps_word,     13 22)          /* A + ; */

ZMK_COMBO(c_ae_mac,     &ae_mac,        13 3, MAC)      /* A + E */
ZMK_COMBO(c_oe_mac,     &oe_mac,         9 3, MAC)      /* O + E */
ZMK_COMBO(c_ue_mac,     &ue_mac,         7 3, MAC)      /* U + E */
ZMK_COMBO(c_ae_win,     &ae_win,        13 3, WIN)
ZMK_COMBO(c_oe_win,     &oe_win,         9 3, WIN)
ZMK_COMBO(c_ue_win,     &ue_win,         7 3, WIN)
ZMK_COMBO(c_ae_lnx,     &ae_lnx,        13 3, LNX)
ZMK_COMBO(c_oe_lnx,     &oe_lnx,         9 3, LNX)
ZMK_COMBO(c_ue_lnx,     &ue_lnx,         7 3, LNX)

ZMK_COMBO(launch_mac,   &kp LG(SPACE),  37 40, MAC)     /* Spotlight */
ZMK_COMBO(launch_other, &kp LA(SPACE),  37 40, WIN LNX)

/* ------------------------------------------------------------------ */
/* Conditional layers                                                 */
/* ------------------------------------------------------------------ */
ZMK_CONDITIONAL_LAYER(control,     NUM SYM,     CTRL)
ZMK_CONDITIONAL_LAYER(win_numnav,  NUM WIN,     WIN_NUM)
ZMK_CONDITIONAL_LAYER(lnx_numnav,  NUM LNX,     LNX_NUM)
ZMK_CONDITIONAL_LAYER(win_symbols, SYM WIN,     WIN_SYM)
ZMK_CONDITIONAL_LAYER(lnx_symbols, SYM LNX,     LNX_SYM)
ZMK_CONDITIONAL_LAYER(win_control, NUM SYM WIN, WIN_CTRL)
ZMK_CONDITIONAL_LAYER(lnx_control, NUM SYM LNX, LNX_CTRL)

/* ------------------------------------------------------------------ */
/* Layers                                                             */
/* ------------------------------------------------------------------ */

/* 0: Base (Mac umlauts) */
ZMK_LAYER(Base,
&ae_mac     &kp Q  &kp W  &kp E     &kp R            &kp T            &kp Y          &kp U      &kp I      &kp O    &kp P     &oe_mac
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F            &kp G            &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V            &kp B            &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &ue_mac
                          &kp LGUI  &mt LSHIFT BSPC  &lt NUM ENTER    &lt SYM DEL    &kp SPACE  &kp RALT
)

/* 1: Windows overlay for Base (also the Windows mode flag) */
ZMK_LAYER(WinBase,
&ae_win  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &oe_win
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &ue_win
                   ___  ___  ___    ___  ___  ___
)

/* 2: Linux overlay for Base (also the Linux mode flag) */
ZMK_LAYER(LinuxBase,
&ae_lnx  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &oe_lnx
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &ue_lnx
                   ___  ___  ___    ___  ___  ___
)

/* 3: NumNav (Mac): word jump on U/O, line start/end on H/;, screenshot bottom right */
ZMK_LAYER(NumNav,
___  ___     &kp N4  &kp N5    &kp N6    &kp C_PREV    ___             MAC_WORD_LEFT  &kp UP     MAC_WORD_RIGHT  ___           MAC_LOCK
___  &kp N0  &kp N1  &kp N2    &kp N3    &kp C_PP      MAC_LINE_START  &kp LEFT       &kp DOWN   &kp RIGHT       MAC_LINE_END  ___
___  ___     &kp N7  &kp N8    &kp N9    &kp C_NEXT    &kp C_VOL_DN    &kp C_VOL_UP   &kp COMMA  &kp DOT         &kp C_MUTE    SCREENSHOT
                     &kp LGUI  &kp BSPC  ___           ___             &kp SPACE      &kp RALT
)

/* 4: Windows NumNav overlay: Ctrl+arrows word jump, Home/End, sleep */
ZMK_LAYER(WinNumNav,
___  ___  ___  ___  ___  ___    ___       &kp LC(LEFT)  ___  &kp LC(RIGHT)  ___      &win_sleep
___  ___  ___  ___  ___  ___    &kp HOME  ___           ___  ___            &kp END  ___
___  ___  ___  ___  ___  ___    ___       ___           ___  ___            ___      ___
               ___  ___  ___    ___       ___           ___
)

/* 5: Linux NumNav overlay: Ctrl+arrows word jump, Home/End, Super+L lock */
ZMK_LAYER(LinuxNumNav,
___  ___  ___  ___  ___  ___    ___       &kp LC(LEFT)  ___  &kp LC(RIGHT)  ___      &kp LG(L)
___  ___  ___  ___  ___  ___    &kp HOME  ___           ___  ___            &kp END  ___
___  ___  ___  ___  ___  ___    ___       ___           ___  ___            ___      ___
               ___  ___  ___    ___       ___           ___
)

/* 6: Symbols (euro = Mac version) */
ZMK_LAYER(Symbols,
___  &kp AT     &kp LT     &kp GT     &kp BSLH   &kp PIPE     MAC_EURO    &kp LBRC   &kp RBRC   &kp DLLR  &kp CARET  &kp GRAVE
___  &kp EXCL   &kp STAR   &kp SLASH  &kp EQUAL  &kp MINUS    &kp LBKT    &kp LPAR   &kp RPAR   &kp RBKT  &kp SEMI   &kp SQT
___  &kp TILDE  &kp PRCNT  &kp PLUS   &kp HASH   &kp AMPS     &kp UNDER   &kp SPACE  &kp COMMA  &kp DOT   &kp QMARK  ___
                           &kp LGUI   &kp BSPC   ___          ___         &kp SPACE  &kp RALT
)

/* 7: Windows Symbols overlay (euro) */
ZMK_LAYER(WinSymbols,
___  ___  ___  ___  ___  ___    &win_euro  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
               ___  ___  ___    ___        ___  ___
)

/* 8: Linux Symbols overlay (euro) */
ZMK_LAYER(LinuxSymbols,
___  ___  ___  ___  ___  ___    &lnx_euro  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
               ___  ___  ___    ___        ___  ___
)

/* 9: Control (NumNav + Symbols held): Mac umlauts, OS mode keys at 33/34/35 */
ZMK_LAYER(Control,
&kp TAB  &kp F1      &kp F2        &kp F3        &kp F4        &kp F5          &kp F6      &kp F7      &kp F8      &kp F9      &kp F10   ___
___      &kp F11     &kp F12       ___           ___           ___             &mac_ae_lo  &mac_oe_lo  &mac_ue_lo  MAC_ESZETT  ___       ___
___      &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &mac_ae_up  &mac_oe_up  &mac_ue_up  &to MAC     &to WIN   &to LNX
                                   &kp LGUI      &kp BSPC      ___             ___         &kp SPACE   &kp RALT
)

/* 10: Windows Control overlay */
ZMK_LAYER(WinControl,
___  ___  ___  ___  ___  ___    ___         ___         ___         ___          ___  ___
___  ___  ___  ___  ___  ___    &win_ae_lo  &win_oe_lo  &win_ue_lo  &win_eszett  ___  ___
___  ___  ___  ___  ___  ___    &win_ae_up  &win_oe_up  &win_ue_up  ___          ___  ___
               ___  ___  ___    ___         ___         ___
)

/* 11: Linux Control overlay */
ZMK_LAYER(LinuxControl,
___  ___  ___  ___  ___  ___    ___         ___         ___         ___          ___  ___
___  ___  ___  ___  ___  ___    &lnx_ae_lo  &lnx_oe_lo  &lnx_ue_lo  &lnx_eszett  ___  ___
___  ___  ___  ___  ___  ___    &lnx_ae_up  &lnx_oe_up  &lnx_ue_up  ___          ___  ___
               ___  ___  ___    ___         ___         ___
)
