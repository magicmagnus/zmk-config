 *
 * Umlaut OS switch: Mac (default) / Windows / Linux
 *
 *   Mac     : Option+U dead key (input source "U.S." or "ABC")
 *   Windows : Alt + numpad code (NumLock on)
 *   Linux   : Ctrl+Shift+U + hex + Enter (IBus / GTK)
 *
 * Switch modes: hold both layer thumbs (Control layer), then press
 *   pos 33 = Mac, pos 34 = Windows, pos 35 = Linux (bottom-right three keys).
 * The mode resets to Mac after a reboot or deep sleep.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* Layer indices. Higher index wins, so OS overlays sit directly above
 * the layer they modify and never bleed into layers above it. */
#define MAC      0   /* Base, Mac bindings */
#define WIN      1   /* Base overlay, Windows (also the Windows mode flag) */
#define LNX      2   /* Base overlay, Linux (also the Linux mode flag) */
#define NUM      3
#define WIN_NUM  4
#define LNX_NUM  5
#define SYM      6
#define WIN_SYM  7
#define LNX_SYM  8
#define CTRL     9
#define WIN_CTRL 10
#define LNX_CTRL 11

#define ___ &trans

/ {
    combos {
        compatible = "zmk,combos";

        /* OS-independent combos (active on all layers) */
        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <2 1>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <2 3>;
        };

        /* Umlaut combos: A+E, O+E, U+E.
         * ZMK checks combo layers against the HIGHEST active layer,
         * so each OS mode gets its own set. */
        combo_ae_mac { bindings = <&ae_mac>; key-positions = <13 3>; layers = <MAC>; };
        combo_oe_mac { bindings = <&oe_mac>; key-positions = <9 3>;  layers = <MAC>; };
        combo_ue_mac { bindings = <&ue_mac>; key-positions = <7 3>;  layers = <MAC>; };

        combo_ae_win { bindings = <&ae_win>; key-positions = <13 3>; layers = <WIN>; };
        combo_oe_win { bindings = <&oe_win>; key-positions = <9 3>;  layers = <WIN>; };
        combo_ue_win { bindings = <&ue_win>; key-positions = <7 3>;  layers = <WIN>; };

        combo_ae_lnx { bindings = <&ae_lnx>; key-positions = <13 3>; layers = <LNX>; };
        combo_oe_lnx { bindings = <&oe_lnx>; key-positions = <9 3>;  layers = <LNX>; };
        combo_ue_lnx { bindings = <&ue_lnx>; key-positions = <7 3>;  layers = <LNX>; };

        /* Launcher: Cmd+Space (Spotlight) on Mac, Alt+Space elsewhere */
        combo_launcher_mac {
            bindings = <&kp LG(SPACE)>;
            key-positions = <37 40>;
            layers = <MAC>;
        };

        combo_launcher_other {
            bindings = <&kp LA(SPACE)>;
            key-positions = <37 40>;
            layers = <WIN LNX>;
        };
    };

    behaviors {
        /* Home row mods: defined but currently unused */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <250>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <250>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        /* Shift-aware umlaut keys: tap = lowercase, Shift+tap = uppercase.
         * Shift is masked while the chosen macro runs. */
        ae_mac: ae_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_ae_lo>, <&mac_ae_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        oe_mac: oe_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_oe_lo>, <&mac_oe_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ue_mac: ue_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_ue_lo>, <&mac_ue_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ae_win: ae_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&win_ae_lo>, <&win_ae_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        oe_win: oe_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&win_oe_lo>, <&win_oe_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ue_win: ue_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&win_ue_lo>, <&win_ue_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ae_lnx: ae_lnx {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lnx_ae_lo>, <&lnx_ae_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        oe_lnx: oe_lnx {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lnx_oe_lo>, <&lnx_oe_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ue_lnx: ue_lnx {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lnx_ue_lo>, <&lnx_ue_up>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        /* ---------------- macOS: Option+U dead key ---------------- */
        mac_ae_lo: mac_ae_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp A>;
        };
        mac_ae_up: mac_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp LS(A)>;
        };
        mac_oe_lo: mac_oe_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp O>;
        };
        mac_oe_up: mac_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp LS(O)>;
        };
        mac_ue_lo: mac_ue_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp U>;
        };
        mac_ue_up: mac_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(U) &kp LS(U)>;
        };

        /* ---------------- Windows: Alt + numpad codes ---------------- */
        win_ae_lo: win_ae_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };
        win_ae_up: win_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };
        win_oe_lo: win_oe_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };
        win_oe_up: win_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };
        win_ue_lo: win_ue_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };
        win_ue_up: win_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };
        win_eszett: win_eszett {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };
        win_euro: win_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };
        win_sleep: win_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            bindings = <&kp LG(X) &kp R &kp E>;
        };

        /* ---------------- Linux: Ctrl+Shift+U, hex, Enter ----------------
         * LC(LS(U)) uses implicit mods so the Shift mask of the
         * uppercase mod-morph cannot swallow the Shift in Ctrl+Shift+U. */
        lnx_ae_lo: lnx_ae_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp E &kp N4 &kp ENTER>;
        };
        lnx_ae_up: lnx_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp C &kp N4 &kp ENTER>;
        };
        lnx_oe_lo: lnx_oe_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp F &kp N6 &kp ENTER>;
        };
        lnx_oe_up: lnx_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp D &kp N6 &kp ENTER>;
        };
        lnx_ue_lo: lnx_ue_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp F &kp C &kp ENTER>;
        };
        lnx_ue_up: lnx_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp D &kp C &kp ENTER>;
        };
        lnx_eszett: lnx_eszett {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp D &kp F &kp ENTER>;
        };
        lnx_euro: lnx_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(LS(U)) &kp N2 &kp N0 &kp A &kp C &kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* 0: Base (Mac umlauts) */
        Base {
            bindings = <
&ae_mac     &kp Q  &kp W  &kp E     &kp R              &kp T          &kp Y          &kp U      &kp I      &kp O    &kp P     &oe_mac
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F              &kp G          &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V              &kp B          &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &ue_mac
                          &kp LGUI  &mt LSHIFT BSPC    &lt NUM ENTER  &lt SYM DEL    &kp SPACE  &kp RALT
            >;
        };

        /* 1: Windows overlay for Base (also the Windows mode flag) */
        WinBase {
            bindings = <
&ae_win  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &oe_win
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &ue_win
                   ___  ___  ___    ___  ___  ___
            >;
        };

        /* 2: Linux overlay for Base (also the Linux mode flag) */
        LinuxBase {
            bindings = <
&ae_lnx  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &oe_lnx
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___      ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &ue_lnx
                   ___  ___  ___    ___  ___  ___
            >;
        };

        /* 3: NumNav (pos 11 = lock screen on Mac: Ctrl+Cmd+Q) */
        NumNav {
            bindings = <
___  ___     &kp N4  &kp N5    &kp N6     &kp C_PREV    ___           &kp PG_UP     &kp UP     &kp PG_DN  ___         &kp LC(LG(Q))
___  &kp N0  &kp N1  &kp N2    &kp N3     &kp C_PP      &kp HOME      &kp LEFT      &kp DOWN   &kp RIGHT  &kp END     ___
___  ___     &kp N7  &kp N8    &kp N9     &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP  &kp COMMA  &kp DOT    &kp C_MUTE  ___
                     &kp LGUI  &kp BSPC   ___           ___           &kp SPACE     &kp RALT
            >;
        };

        /* 4: Windows NumNav overlay (pos 11 = original sleep macro) */
        WinNumNav {
            bindings = <
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &win_sleep
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
               ___  ___  ___    ___  ___  ___
            >;
        };

        /* 5: Linux NumNav overlay (pos 11 = Super+L, lock on most desktops) */
        LinuxNumNav {
            bindings = <
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  &kp LG(L)
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___  ___  ___  ___  ___  ___
               ___  ___  ___    ___  ___  ___
            >;
        };

        /* 6: Symbols (pos 6 = euro, Mac: Option+Shift+2) */
        Symbols {
            bindings = <
___  &kp AT     &kp LT       &kp GT     &kp BSLH   &kp PIPE     &kp LA(LS(N2))  &kp LBRC   &kp RBRC   &kp DLLR   &kp CARET  &kp GRAVE
___  &kp EXCL   &kp STAR     &kp SLASH  &kp EQUAL  &kp MINUS    &kp LBKT        &kp LPAR   &kp RPAR   &kp RBKT   &kp SEMI   &kp SQT
___  &kp TILDE  &kp PRCNT    &kp PLUS   &kp HASH   &kp AMPS     &kp UNDER       &kp SPACE  &kp COMMA  &kp DOT    &kp QMARK  ___
                             &kp LGUI   &kp BSPC   ___          ___             &kp SPACE  &kp RALT
            >;
        };

        /* 7: Windows Symbols overlay (euro) */
        WinSymbols {
            bindings = <
___  ___  ___  ___  ___  ___    &win_euro  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
               ___  ___  ___    ___        ___  ___
            >;
        };

        /* 8: Linux Symbols overlay (euro) */
        LinuxSymbols {
            bindings = <
___  ___  ___  ___  ___  ___    &lnx_euro  ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
___  ___  ___  ___  ___  ___    ___        ___  ___  ___  ___  ___
               ___  ___  ___    ___        ___  ___
            >;
        };

        /* 9: Control (NumNav + Symbols held). Mac umlauts, OS mode keys at 33/34/35 */
        Control {
            bindings = <
&kp TAB  &kp F1      &kp F2        &kp F3        &kp F4        &kp F5          &kp F6      &kp F7      &kp F8      &kp F9     &kp F10   ___
___      &kp F11     &kp F12       ___           ___           ___             &mac_ae_lo  &mac_oe_lo  &mac_ue_lo  &kp LA(S)  ___       ___
___      &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &mac_ae_up  &mac_oe_up  &mac_ue_up  &to MAC    &to WIN   &to LNX
                                   &kp LGUI      &kp BSPC      ___             ___         &kp SPACE   &kp RALT
            >;
        };

        /* 10: Windows Control overlay */
        WinControl {
            bindings = <
___  ___  ___  ___  ___  ___    ___         ___         ___         ___          ___  ___
___  ___  ___  ___  ___  ___    &win_ae_lo  &win_oe_lo  &win_ue_lo  &win_eszett  ___  ___
___  ___  ___  ___  ___  ___    &win_ae_up  &win_oe_up  &win_ue_up  ___          ___  ___
               ___  ___  ___    ___         ___         ___
            >;
        };

        /* 11: Linux Control overlay */
        LinuxControl {
            bindings = <
___  ___  ___  ___  ___  ___    ___         ___         ___         ___          ___  ___
___  ___  ___  ___  ___  ___    &lnx_ae_lo  &lnx_oe_lo  &lnx_ue_lo  &lnx_eszett  ___  ___
___  ___  ___  ___  ___  ___    &lnx_ae_up  &lnx_oe_up  &lnx_ue_up  ___          ___  ___
               ___  ___  ___    ___         ___         ___
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        control      { if-layers = <NUM SYM>;     then-layer = <CTRL>;     };

        win_numnav   { if-layers = <NUM WIN>;     then-layer = <WIN_NUM>;  };
        lnx_numnav   { if-layers = <NUM LNX>;     then-layer = <LNX_NUM>;  };

        win_symbols  { if-layers = <SYM WIN>;     then-layer = <WIN_SYM>;  };
        lnx_symbols  { if-layers = <SYM LNX>;     then-layer = <LNX_SYM>;  };

        win_control  { if-layers = <NUM SYM WIN>; then-layer = <WIN_CTRL>; };
        lnx_control  { if-layers = <NUM SYM LNX>; then-layer = <LNX_CTRL>; };
    };
};
